# Pesos de modelos: se descargan, no se versionan. Las reglas de arriba apuntan a
# backend/ y el proyecto vive en app/backend/, así que ggml-base.bin (144 MB) se
# colaba — y GitHub rechaza cualquier archivo de más de 100 MB.
app/backend/whisper/models/
app/backend/piper/models/

# Fork del runtime del agente: el fuente se versiona, el entorno no.
app/agent-runtime/venv/
app/agent-runtime/**/__pycache__/
# Estado en caliente del runtime del agente (caches, locks, dbs). Las skills, la
# memoria y el SOUL de Niki sí se versionan — se agregan explícitamente.
app/backend/agent-home/*
!app/backend/agent-home/skills/
!app/backend/agent-home/memories/
!app/backend/agent-home/SOUL.md
