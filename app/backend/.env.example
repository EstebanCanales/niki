NODE_ENV=development
PORT=8000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Auth keys
WRAPPER_API_KEY=
# Legacy alias for WRAPPER_API_KEY (fallback)
CLAWBOT_API_KEY=
INTERNAL_API_KEY=dev-internal-key

# Agente local (Groq) con control de la computadora
# Si GROQ_API_KEY está presente, Niki usa el agente local por defecto (provider=groq-local),
# que ejecuta herramientas de control de la Mac mediante function-calling.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Proveedor del agente: auto | groq-local | hermes  (vacío = auto)
NIKI_AGENT_PROVIDER=
# Modo de control de la computadora: open | guarded | locked  (default: guarded)
#   open    = todo permitido (salvo denylist de seguridad)
#   guarded = acciones de alto riesgo requieren confirm=true
#   locked  = solo acciones de solo-lectura
NIKI_COMPUTER_CONTROL_MODE=guarded

# Qwen3-TTS local (se carga una vez en memoria para conversación manos libres)
# Crea el entorno con: python3.12 -m venv venv-qwen3-tts && pip install -U qwen-tts soundfile
QWEN3_TTS_PYTHON=./venv-qwen3-tts/bin/python3
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN3_TTS_DEVICE=auto
QWEN3_TTS_SPEAKER=Serena

# Hermes API Server settings (proveedor alterno)
HERMES_API_SERVER_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=Hermes-4-70B
# Path to Hermes config file (default: ~/.hermes/config.yaml)
HERMES_CONFIG_PATH=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CORS / Origin guard
# Comma-separated extra allowed origins (e.g. http://localhost:1420,tauri://localhost)
NIKI_ALLOWED_ORIGINS=
# Set to 1 to disable origin guard (dev only)
NIKI_DISABLE_ORIGIN_GUARD=
# Set to 1 to skip HTTP listen (useful for testing bootstrap without a port)
NIKI_NO_LISTEN=
