DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/niki_cloud?schema=public"
MAGIC_CODE_PEPPER="replace-with-a-long-random-secret"
SESSION_COOKIE_SECRET="replace-with-a-different-long-random-secret"
# Required: generate a 32-byte base64 key with `openssl rand -base64 32`.
DEVICE_SECRET_ENCRYPTION_KEY="replace-with-base64-output-from-openssl-rand-base64-32"
# Required and independent from the device key: encrypts synchronized message content.
CONVERSATION_ENCRYPTION_KEY="replace-with-a-second-base64-output-from-openssl-rand-base64-32"
RESEND_API_KEY=
MAIL_FROM=
NIKI_CLOUD_DEV_AUTH=0
PORT=4001
WEB_ORIGIN=http://localhost:3001
