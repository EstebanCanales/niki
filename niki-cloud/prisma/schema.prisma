generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String          @id @default(uuid()) @db.Uuid
  email                   String          @unique
  displayName             String?
  conversationSyncEnabled Boolean         @default(false)
  createdAt               DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(6)
  magicCodes              MagicCode[]
  webSessions             WebSession[]
  devices                 Device[]
  usageEvents             UsageEvent[]
  creditEntries           CreditEntry[]
  conversations           Conversation[]
  syncCursors             SyncCursor[]
}

model WaitlistEntry {
  id              String   @id @default(uuid()) @db.Uuid
  email           String
  emailNormalized String   @unique
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
}

model MagicCode {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String?   @db.Uuid
  emailNormalized String
  codeHash        String
  expiresAt       DateTime  @db.Timestamptz(6)
  attemptCount    Int       @default(0)
  consumedAt      DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([emailNormalized, expiresAt])
}

model WebSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Device {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String
  platform   String?
  secretHash String
  linkedAt   DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents UsageEvent[]
  conversations Conversation[]
  syncCursors SyncCursor[]

  @@index([userId, revokedAt])
}

model UsageEvent {
  id             String        @id @default(uuid()) @db.Uuid
  eventId        String        @unique
  userId         String        @db.Uuid
  deviceId       String        @db.Uuid
  conversationId String?       @db.Uuid
  category       String
  quantity       BigInt
  model          String?
  metadata       Json?
  occurredAt     DateTime      @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  creditEntry    CreditEntry?

  @@index([userId, occurredAt])
  @@index([deviceId, occurredAt])
}

model CreditEntry {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  sourceEventId String?     @unique
  amountMicros  BigInt
  kind          String
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEvent   UsageEvent? @relation(fields: [sourceEventId], references: [eventId], onDelete: Restrict)

  @@index([userId, createdAt])
}

model Conversation {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  deviceId     String?      @db.Uuid
  externalId   String
  title        String?
  lastMessageAt DateTime?   @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(6)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  messages     Message[]
  usageEvents  UsageEvent[]

  @@unique([userId, externalId])
  @@index([userId, lastMessageAt])
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  conversationId    String       @db.Uuid
  externalId        String
  role              String
  contentCiphertext String
  contentNonce      String
  contentAuthTag    String
  occurredAt        DateTime     @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, occurredAt])
}

model SyncCursor {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceId     String    @db.Uuid
  cursor       String?
  lastSyncedAt DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
}
